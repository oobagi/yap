{
  "name": "yap",
  "version": "4.3.0",
  "description": "Cross-platform voice-to-text tray app",
  "author": "igaboo",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "electron:dev": "concurrently -k -s first -n svelte,electron \"pnpm run dev\" \"pnpm run electron:build-core:debug && pnpm run electron:prepare-dev-permissions && pnpm run electron:build-sidecar && wait-on tcp:1420 && electron-vite dev\"",
    "electron:build": "pnpm run build && electron-vite build",
    "electron:build-core:debug": "cargo build --manifest-path native-core/Cargo.toml --bin yap-core",
    "electron:build-core": "cargo build --manifest-path native-core/Cargo.toml --release --bin yap-core",
    "electron:build-sidecar": "node scripts/build-sidecar.mjs",
    "electron:prepare-dev-permissions": "node scripts/prepare-dev-permissions.mjs",
    "electron:package": "pnpm run electron:build && pnpm run electron:build-core && pnpm run electron:build-sidecar && electron-builder --config electron-builder.yml",
    "electron:package:ci": "pnpm run electron:build && pnpm run electron:build-core && pnpm run electron:build-sidecar && electron-builder --config electron-builder.yml --publish never",
    "electron:verify-mac-entitlements": "node scripts/verify-mac-entitlements.mjs",
    "electron:check": "tsc --noEmit --project tsconfig.electron.json",
    "electron:test-signing": "node --test scripts/mac-signing.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ],
    "patchedDependencies": {
      "app-builder-lib@26.8.1": "patches/app-builder-lib@26.8.1.patch"
    }
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "wait-on": "^9.0.10"
  }
}
